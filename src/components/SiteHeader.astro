---
import HackneyLogo from "./HackneyLogo.astro";
import SiteNav from "./SiteNav.astro";
import { serviceName, serviceTagline } from "../data/navigation";
---

<header class="lbh-header">
  <div class="lbh-header__main">
    <div class="lbh-container lbh-header__wrapper rse-header__wrapper">
      <div class="lbh-header__title">
        <a href="/" class="lbh-header__title-link">
          <HackneyLogo />
          <span class="lbh-header__logo-text">Hackney</span>
          <span class="lbh-header__service-name">
            {serviceName}
            <span class="rse-header__tagline">{serviceTagline}</span>
          </span>
        </a>
      </div>
      <form
        class="rse-header__search"
        action="/services"
        method="get"
        role="search"
      >
        <div class="govuk-form-group lbh-form-group lbh-search-box">
          <label class="govuk-visually-hidden" for="site-search">
            Search this site
          </label>
          <input
            class="govuk-input lbh-input"
            id="site-search"
            name="q"
            type="search"
            placeholder="Search this site"
          />
          <button class="lbh-search-box__action" type="submit">
            <span class="govuk-visually-hidden">Search</span>
            <svg
              width="16"
              height="16"
              viewBox="0 0 16 16"
              fill="none"
              aria-hidden="true"
            >
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M9.6999 10.6C12.0747 10.6 13.9999 8.67482 13.9999 6.3C13.9999 3.92518 12.0747 2 9.6999 2C7.32508 2 5.3999 3.92518 5.3999 6.3C5.3999 8.67482 7.32508 10.6 9.6999 10.6ZM9.6999 12.6C13.1793 12.6 15.9999 9.77939 15.9999 6.3C15.9999 2.82061 13.1793 0 9.6999 0C6.22051 0 3.3999 2.82061 3.3999 6.3C3.3999 9.77939 6.22051 12.6 9.6999 12.6Z"
                fill="#0B0C0C"
              ></path>
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M6.70706 10.7071L1.70706 15.7071L0.292847 14.2929L5.29285 9.29289L6.70706 10.7071Z"
                fill="#0B0C0C"
              ></path>
            </svg>
          </button>
        </div>
      </form>
    </div>
  </div>
</header>
<SiteNav />
